# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=chatapp
DB_ECHO=false

# Application Configuration
APP_PORT=8000
APP_HOST=0.0.0.0
DEV_PORT=8002

# WebSocket Configuration (defaults to APP_PORT if not set)
WS_PORT=8000

# Adminer Configuration
ADMINER_PORT=8080

# External Services (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Gateway (optional, opt-in)
# Set BOTH to route OpenAI/Anthropic SDK clients through a LiteLLM gateway.
# When BOTH unset, SDK clients use OPENAI_API_KEY/ANTHROPIC_API_KEY directly (no change).
# - OpenAI SDK receives LLM_GATEWAY_BASE_URL verbatim (include /v1 suffix).
# - Anthropic SDK receives LLM_GATEWAY_BASE_URL with trailing /v1 stripped.
# LLM_GATEWAY_BASE_URL=http://localhost:18400/v1
# LLM_GATEWAY_API_KEY=GATEWAY_KEY_PLACEHOLDER

# Development Settings
DEV_MODE=true
LOG_LEVEL=INFO